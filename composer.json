{
    "name": "in10/api-gateway-drupal",
    "description": "API gateway package for use with a Drupal CMS",
    "authors": [
        {
            "name": "Stephan de Bruin",
            "email": "stephan.de.bruin@in10.nl"
        }
    ],
    "minimum-stability": "stable",
    "require": {
        "php-http/guzzle7-adapter": "^1.0",
        "woohoolabs/yang": "*"
    },
    "autoload": {
        "psr-4": {
            "IN10\\ApiGatewayDrupal\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "IN10\\ApiGatewayDrupal\\ApiGatewayDrupalServiceProvider"
            ]
        }
    }
}
